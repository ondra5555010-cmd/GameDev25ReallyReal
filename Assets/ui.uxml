<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="player_units_display" style="flex-grow: 1; position: absolute; top: 10px; left: 10px;" />
    <ui:VisualElement name="computer_units_display" style="flex-grow: 1; position: absolute; top: 10px; left: auto; right: 10px; bottom: auto;" />
    <ui:VisualElement name="selected_unit_display" enabled="true" style="flex-grow: 1; position: absolute; top: auto; left: 10px; right: auto; bottom: 10px; width: 1000px; height: 180px; display: none;">
        <ui:Label text="Label" name="unit_name" style="font-size: 42px; -unity-font-style: normal; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255);" />
        <ui:Label text="Label" name="special_ability_description" style="font-size: 24px; color: rgb(255, 255, 255); -unity-text-outline-width: 0.5px; -unity-text-outline-color: rgb(0, 0, 0);" />
        <ui:VisualElement name="stat_lines" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: center; align-content: flex-start; align-self: auto;">
            <ui:Label text="Label" name="unit_hp" style="font-size: 36px; align-content: flex-start; justify-content: flex-start; align-items: stretch; -unity-text-align: lower-left; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:Label text="Label" name="unit_AC" style="font-size: 36px; -unity-text-align: lower-left; color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 1px;" />
            <ui:Label text="Label" name="unit_dmg" style="width: auto; font-size: 36px; -unity-text-align: lower-left; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
            <ui:Label text="Label" name="unit_attk" style="font-size: 36px; -unity-text-align: lower-left; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); color: rgb(255, 255, 255);" />
            <ui:Label text="Label" name="unit_mp" style="font-size: 36px; -unity-text-align: lower-left; display: flex; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label text="YOUR TURN, PRESS &lt;SPACEBAR&gt; TO END" name="player_turn_signal" style="-unity-text-align: upper-center; font-size: 20px; color: rgb(255, 255, 255); -unity-text-outline-width: 1px;" />
</ui:UXML>
